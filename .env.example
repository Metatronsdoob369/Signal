DATABASE_URL=postgresql://signal:signal@localhost:5433/signal
APP_ORIGIN=http://localhost:3000
# Proxies in front of Signal that append X-Forwarded-For. 0 for local dev or any direct exposure
# (a forged header is then ignored and callers share one bucket). Production sets the real count, 1 behind
# Vercel, Fly, or Cloudflare.
TRUSTED_PROXY_HOPS=0
